# Copy this file to `.env.local` in this repo (dev) and/or
# `%APPDATA%\com.codexdesk.app\.env.local` (Windows app data).
# Never commit the copied file. Never paste a real PAT here.

# Azure-hosted LLM HTTP endpoint (no credentials in the URL).
# Codex Desk does not call this itself; it only shows status and
# can pass the value through to the local Codex process.
AZURE_LLM_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/openai/v1

# Registered PAT — environment variable only. Never put this in
# config.toml, config/models.json, git, or SQLite.
# Default Codex config.toml env_key name:
# AZURE_OPENAI_API_KEY=

# Desk alias: when this is set and AZURE_OPENAI_API_KEY is not,
# Desk exports it as AZURE_OPENAI_API_KEY to the child `codex` only.
AZURE_LLM_PAT=
